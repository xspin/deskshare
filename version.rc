// version.rc - Windows 文件版本信息配置
#include "winver.h"  // 包含版本信息相关宏定义

// 版本信息块（固定格式）
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0           // 文件版本（主版本,次版本,修订号,构建号）
 PRODUCTVERSION 1,1,0,0        // 产品版本
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG         // 调试版本标记
#else
 FILEFLAGS 0x0L                // 发布版本（无标记）
#endif
 FILEOS VOS__WINDOWS32         // 操作系统：32位 Windows
 FILETYPE VFT_APP              // 文件类型：应用程序（VFT_DLL 表示 DLL）
 FILESUBTYPE 0x0L              // 子类型：无
BEGIN
    BLOCK "StringFileInfo"     // 字符串信息块（多语言支持）
    BEGIN
        BLOCK "040904b0"       // 语言代码（0409=英语，0804=中文；04b0=Unicode）
        BEGIN
            VALUE "CompanyName", "None\0"               // 公司名称
            VALUE "FileDescription", "DeskShare Application\0"       // 文件描述
            VALUE "FileVersion", "1.0.0.0\0"                // 文件版本字符串
            VALUE "InternalName", "DeskShare\0"                  // 内部名称
            VALUE "LegalCopyright", "Copyright (C) 2025 None.\0"  // 版权信息
            VALUE "OriginalFilename", "deskshare.exe\0"          // 原始文件名
            VALUE "ProductName", "DeskShare\0"                // 产品名称
            VALUE "ProductVersion", "1.1.0.0\0"             // 产品版本字符串
        END
    END
    BLOCK "VarFileInfo"         // 变量信息块（指定语言）
    BEGIN
        VALUE "Translation", 0x0409, 1200  // 对应上面的语言代码（0409=英语，1200=Unicode）
    END
END